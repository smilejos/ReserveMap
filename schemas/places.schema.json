{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://reservemap.local/schemas/places.schema.json",
  "title": "ReserveMap places",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "places"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "places": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uid",
          "id",
          "name",
          "countryId",
          "regionId",
          "categoryId",
          "subcategoryId",
          "coordinates",
          "googleMapsUrl",
          "address",
          "note",
          "rating"
        ],
        "properties": {
          "uid": { "type": "string", "format": "uuid" },
          "id": { "type": "string", "pattern": "^[A-Z]{2}-[FLSH]-[0-9]{5}$" },
          "name": { "type": "string", "pattern": ".*\\S.*" },
          "countryId": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "regionId": { "type": "string", "pattern": "^[A-Z]{2}-[A-Z0-9-]+$" },
          "categoryId": { "enum": ["F", "L", "S", "H"] },
          "subcategoryId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "coordinates": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lat", "lng"],
            "properties": {
              "lat": { "type": "number", "minimum": -90, "maximum": 90 },
              "lng": { "type": "number", "minimum": -180, "maximum": 180 }
            }
          },
          "googleMapsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
          "address": { "type": ["string", "null"] },
          "note": { "type": "string" },
          "rating": { "enum": [null, 1, 1.5, 2, 2.5, 3, 3.5, 4, 4.5, 5] }
        }
      }
    }
  }
}
