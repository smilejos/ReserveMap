{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://reservemap.local/schemas/definitions.schema.json",
  "title": "ReserveMap definitions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "countries", "regions", "categories"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "countries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "countryId", "name", "center", "zoom"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z]{2}-[A-Z0-9-]+$" },
          "countryId": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "name": { "type": "string", "minLength": 1 },
          "center": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lat", "lng"],
            "properties": {
              "lat": { "type": "number", "minimum": -90, "maximum": 90 },
              "lng": { "type": "number", "minimum": -180, "maximum": 180 }
            }
          },
          "zoom": { "type": "integer", "minimum": 1, "maximum": 22 }
        }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "color", "subcategories"],
        "properties": {
          "id": { "enum": ["F", "L", "S", "H"] },
          "name": { "type": "string", "minLength": 1 },
          "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "subcategories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "icon"],
              "properties": {
                "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
                "name": { "type": "string", "minLength": 1 },
                "icon": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
